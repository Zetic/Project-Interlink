{
  "name": "project-interlink",
  "version": "0.1.0",
  "description": "Project Interlink simulation regression tests",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:js",
    "test:js": "node --test tests/*.test.js",
    "test:rust": "cargo test --workspace",
    "check:wasm": "cargo check -p interlink-wasm --target wasm32-unknown-unknown",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm-package": "bash scripts/build-wasm.sh target/wasm-package",
    "check:runtime": "npm run typecheck && npm run test:js && npm run test:rust && npm run check:wasm"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
