{
  "name": "project-interlink",
  "version": "0.1.0",
  "description": "Project Interlink simulation regression tests",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:ts",
    "test:ts": "tsx --test tests/*.test.ts",
    "test:rust": "cargo test --workspace",
    "check:wasm": "cargo check -p interlink-wasm --target wasm32-unknown-unknown",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm-package": "bash scripts/build-wasm.sh target/wasm-package",
    "check:worldgen-wasm": "cargo check -p interlink-worldgen-wasm --target wasm32-unknown-unknown",
    "build:worldgen-wasm": "bash scripts/build-worldgen-wasm.sh",
    "check:worldgen-wasm-package": "bash scripts/build-worldgen-wasm.sh target/worldgen-wasm-package",
    "worldgen:generate": "cargo run -p interlink-worldgen-cli -- generate",
    "worldgen:benchmark": "cargo run -p interlink-worldgen-cli -- benchmark",
    "worldgen:topology": "cargo run -p interlink-worldgen-cli -- topology --level 4",
    "check:runtime": "npm run build && npm run test:ts && npm run test:rust && npm run check:wasm && npm run check:worldgen-wasm"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "5.8.3"
  }
}
